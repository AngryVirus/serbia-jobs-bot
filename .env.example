# Secrets belong in private Render / environment settings, never GitHub files.
# Legacy isolated development only. Production uses Telegram Serverless + Actions.
# Never configure or resume Render for @SerbiaJobsBot using this file.
# Polling/webhook additionally requires an explicit process environment opt-in;
# see README.md. Local imports and unit tests do not require credentials.
TELEGRAM_BOT_TOKEN=
# Required for Render webhook mode (server-side secret or legacy service_role):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WEBHOOK_SECRET=
COLLECT_SECRET=
# Render provides RENDER_EXTERNAL_URL and PORT automatically.
# Other hosts need an explicit public HTTPS URL:
WEBHOOK_BASE_URL=
PORT=10000
SCAN_INTERVAL_MINUTES=30
# SQLite is only for local development:
DATABASE_PATH=data/jobs.sqlite3
